</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.18" />
  </ItemGroup>

</Project>
